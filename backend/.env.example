# Local development defaults. Copy to .env and adjust. NEVER commit real secrets.
DJANGO_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches docker-compose.yml service at the repo root
DATABASE_URL=postgis://localads:localads@localhost:5432/localads

CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1

# Garage (S3-compatible, docker-compose.yml). Leave USE_S3=false to keep
# uploads on local disk. Creds match GARAGE_DEFAULT_* in docker-compose.yml.
USE_S3=false
S3_ENDPOINT_URL=http://localhost:3900
S3_ACCESS_KEY=GK1f5d0333ca9c2ee30a6718a78d0282fa
S3_SECRET_KEY=e7024f746ec17e2814c5cb8d5371a0b8a96b1aacfa512265430715770f76aadf
S3_BUCKET_NAME=localads-media
# Garage validates the sigv4 region — it must equal s3_region
# in infra/docker/garage.toml.
S3_REGION=garage
# Storage is private; media URLs go through Django's /media route
# (apps/core/media.py). This must point at wherever that route is served.
S3_PUBLIC_DOMAIN=localhost:8000/media
S3_URL_PROTOCOL=http:

# fake | click  (payment gateway slug; only `fake` works until CLICK verification, spec §19 [E])
PAYMENT_PROVIDER=fake

# CLICK provider credentials — placeholders until merchant onboarding (spec §19 [E]).
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# CORS: Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Browser CSRF origin trust (Vite dev; add the prod domain in deployment env)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SMS providers (spec §9; fake | devsms | eskiz) ---
SMS_PROVIDER=fake
# DevSMS (devsms.uz) — API v1 universal OTP; token from dashboard -> API keys
DEVSMS_API_TOKEN=
DEVSMS_BASE_URL=https://devsms.uz/api/v1
DEVSMS_SERVICE_NAME=LocalAds
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Play Mobile has no verified public docs yet — adapter raises (ADR-0006)
