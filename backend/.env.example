# Local development defaults. Copy to .env and adjust. NEVER commit real secrets.
DJANGO_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches docker-compose.yml service at the repo root
DATABASE_URL=postgis://localads:localads@localhost:5432/localads

CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1

# MinIO (S3-compatible). Leave USE_S3=false to keep uploads on local disk.
USE_S3=false
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=localads-media

# fake | eskiz | play_mobile  (only `fake` is implemented; others raise NotImplementedError)
SMS_PROVIDER=fake

# fake | click  (payment gateway slug; only `fake` works until CLICK verification, spec §19 [E])
PAYMENT_PROVIDER=fake

# CLICK provider credentials — placeholders until merchant onboarding (spec §19 [E]).
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# CORS: Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Browser CSRF origin trust (Vite dev; add the prod domain in deployment env)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
