# Template for infra/docker/.env.prod (never committed). Fill every value.
# Used both for compose variable interpolation (--env-file) and as the web
# containers' env_file.

# Django (required; prod settings refuse the dev secret or fake providers)
DJANGO_SECRET_KEY=          # openssl rand -hex 50
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=       # e.g. ads.example.uz
CORS_ALLOWED_ORIGINS=       # e.g. https://ads.example.uz
SMS_PROVIDER=               # eskiz (fake is dev-only; prod refuses it)
PAYMENT_PROVIDER=           # click, once merchant verification is done (spec §19)

# PostgreSQL
POSTGRES_PASSWORD=change-me

# Garage bootstrap key (created by the garage container on first start; owner
# of the media bucket; used ONLY by the garage container, never by the app).
# Generate: access = "GK$(openssl rand -hex 16)", secret = openssl rand -hex 32
GARAGE_DEFAULT_ACCESS_KEY=change-me
GARAGE_DEFAULT_SECRET_KEY=change-me

# Least-privilege app key for the media bucket (imported by
# infra/scripts/garage-init.sh; read/write on localads-media only — no bucket
# creation). Same generation commands as above.
GARAGE_APP_ACCESS_KEY=change-me
GARAGE_APP_SECRET_KEY=change-me

# Public media URL base: the server-mediated /media route on the site domain
# (spec §11). Media objects are never exposed directly by Garage.
MEDIA_PUBLIC_DOMAIN=ads.example.uz/media

# Telegram OTP delivery (optional, ADR-0006; see deploy runbook). Leave the
# token empty to keep OTP SMS-only. Secret charset: A-Z a-z 0-9 _ -
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=   # openssl rand -hex 32

# Optional overrides
# GARAGE_IMAGE=dxflrs/garage:v2.4.1  # pin for reproducibility
# AWSCLI_IMAGE=amazon/aws-cli:latest
# ENV_FILE=infra/docker/.env.prod
# TAG=abc1234  # deploy.sh sets this from git by default
