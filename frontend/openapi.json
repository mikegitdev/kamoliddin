      summary: Disable/enable a business (hides all its ads live)
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/StatusChange'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/StatusChange'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/StatusChange'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Ok'
          description: ''
  /api/v1/admin/campaigns:
    get:
      operationId: api_v1_admin_campaigns_list
      description: GET /admin/campaigns?q=&status=&business= — searchable, paginated.
      parameters:
      - name: limit
