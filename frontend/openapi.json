          type: string
          readOnly: true
        address:
          type: string
          readOnly: true
        lon:
          type: number
          format: double
          readOnly: true
        lat:
          type: number
          format: double
          readOnly: true
        hours:
          readOnly: true
        phone:
          type: string
          readOnly: true
        telegram:
          type: string
          readOnly: true
        whatsapp:
          type: string
          readOnly: true
        business_site:
          type: string
          readOnly: true
      required:
      - address
      - business_site
      - hours
      - id
      - lat
      - lon
      - name
      - phone
      - telegram
      - whatsapp
