      operationId: api_v1_auth_me_destroy
      description: Anonymizes the phone, disables owned businesses and auto-renewals;
        financial records are retained (spec §14). Terminates the session.
      summary: Delete own account (soft)
      tags:
      - Auth
      security:
      - cookieAuth: []
