    RenewalAgreement:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        business:
          type: string
          format: uuid
          readOnly: true
        business_name:
          type: string
          readOnly: true
        campaign:
          type: string
          format: uuid
          readOnly: true
        campaign_headline:
          type: string
          readOnly: true
        locations_snapshot:
          readOnly: true
          description: Frozen location id list for renewal
        locations_count:
          type: integer
          readOnly: true
        charge_days:
          type: integer
          readOnly: true
        duration_seconds:
          type: integer
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/RenewalAgreementStatusEnum'
          readOnly: true
          description: |-
            pending_token agreements never charge — no verified provider token (ADR-0005)

            * `active` - Active
            * `alert` - Alert (last charge failed)
            * `disabled` - Disabled (cancelled by advertiser)
            * `pending_token` - Awaiting provider token (no verified adapter)
        price_policy:
          type: string
          readOnly: true
          description: current_tariff | locked_price — must be shown and consented
            to (spec §8 [O])
        consent_at:
          type: string
          format: date-time
          readOnly: true
        next_run_at:
          type: string
          format: date-time
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - business
      - business_name
      - campaign
      - campaign_headline
      - charge_days
      - consent_at
      - created_at
      - duration_seconds
      - id
      - locations_count
      - locations_snapshot
      - next_run_at
      - price_policy
      - status
      - updated_at
    RenewalAgreementStatusEnum:
      enum:
      - active
      - alert
      - disabled
      - pending_token
      type: string
      description: |-
        * `active` - Active
        * `alert` - Alert (last charge failed)
        * `disabled` - Disabled (cancelled by advertiser)
        * `pending_token` - Awaiting provider token (no verified adapter)
    Report:
      type: object
