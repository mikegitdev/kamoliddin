openapi: 3.0.3
info:
  title: Local Advertising Map Platform API
  version: 1.0.0
  description: Public map/advertising API v1. Money is integer minor units (tiyin,
    UZS).
paths:
  /api/v1/admin/activity:
    get:
      operationId: api_v1_admin_activity_list
      description: GET /admin/activity — immutable audit trail tail.
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Activity'
          description: ''
  /api/v1/admin/campaigns:
    get:
      operationId: api_v1_admin_campaigns_list
      description: GET /admin/campaigns?q=&status= — searchable oversight list.
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/AdminCampaign'
          description: ''
  /api/v1/admin/campaigns/{id}/review:
    post:
      operationId: api_v1_admin_campaigns_review_create
      summary: Approve/reject a campaign version
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Review'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Review'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Review'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/campaigns/{id}/suspend:
    post:
      operationId: api_v1_admin_campaigns_suspend_create
      summary: Suspend (takedown) an approved campaign
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CampaignSuspend'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CampaignSuspend'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CampaignSuspend'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/campaigns/{id}/unsuspend:
    post:
      operationId: api_v1_admin_campaigns_unsuspend_create
      summary: Restore a suspended campaign
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/grants:
    get:
      operationId: api_v1_admin_grants_retrieve
      summary: Options for the grant form
      tags:
      - Admin
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
    post:
      operationId: api_v1_admin_grants_create
      summary: Issue a zero-charge placement grant
      tags:
      - Admin
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Grant'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Grant'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Grant'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/orders:
    get:
      operationId: api_v1_admin_orders_list
      description: GET /admin/orders — recent platform orders (read-only oversight).
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/AdminOrder'
          description: ''
  /api/v1/admin/overview:
    get:
      operationId: api_v1_admin_overview_retrieve
      description: GET /admin/overview — moderation dashboard counters.
      summary: Platform moderation overview
      tags:
      - Admin
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/refunds:
    get:
      operationId: api_v1_admin_refunds_list
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Refund'
          description: ''
  /api/v1/admin/refunds/{id}/process:
    post:
      operationId: api_v1_admin_refunds_process_create
      summary: Manually process a refund request
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RefundProcess'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RefundProcess'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RefundProcess'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/reports:
    get:
      operationId: api_v1_admin_reports_list
      description: GET /admin/reports?state=open — the complaints work queue.
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Report'
          description: ''
  /api/v1/admin/reports/{id}/process:
    post:
      operationId: api_v1_admin_reports_process_create
      summary: Resolve or dismiss a report
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ReportProcess'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ReportProcess'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ReportProcess'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/review-queue:
    get:
      operationId: api_v1_admin_review_queue_list
      description: GET /admin/review-queue — campaigns submitted/under_review, oldest
        first.
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/QueueCampaign'
          description: ''
  /api/v1/admin/settings/ad-limit:
    get:
      operationId: api_v1_admin_settings_ad_limit_retrieve
      summary: Current max simultaneous ads per location
      tags:
      - Admin
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
    patch:
      operationId: api_v1_admin_settings_ad_limit_partial_update
      summary: Change max simultaneous ads per location
      tags:
      - Admin
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedAdLimit'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedAdLimit'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedAdLimit'
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/csrf:
    get:
      operationId: api_v1_auth_csrf_retrieve
      description: |-
        GET /auth/csrf — ensures the csrftoken cookie exists so the SPA can send
        X-CSRFToken on authenticated mutations (spec §9).
      tags:
      - api
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/logout:
    post:
      operationId: api_v1_auth_logout_create
      summary: Terminate the current session
      tags:
      - Auth
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/auth/me:
    get:
      operationId: api_v1_auth_me_retrieve
      summary: Current session user
      tags:
      - Auth
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionUser'
          description: ''
    delete:
      operationId: api_v1_auth_me_destroy
      description: Anonymizes the phone, disables owned businesses and auto-renewals;
        financial records are retained (spec §14). Terminates the session.
      summary: Delete own account (soft)
      tags:
      - Auth
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/auth/me/summary:
    get:
      operationId: api_v1_auth_me_summary_retrieve
      summary: Owner dashboard summary
      tags:
      - Auth
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/otp/request:
    post:
      operationId: api_v1_auth_otp_request_create
      description: Rate-limited. Always returns the same shape whether or not the
        phone number is known (anti-enumeration).
      summary: Request a phone OTP
      tags:
      - Auth
      security:
      - cookieAuth: []
      - {}
      responses:
        '202':
          description: No response body
  /api/v1/auth/otp/verify:
    post:
      operationId: api_v1_auth_otp_verify_create
      summary: Verify OTP and open a session
      tags:
      - Auth
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionUser'
          description: ''
  /api/v1/auth/phone/change/request:
    post:
      operationId: api_v1_auth_phone_change_request_create
      description: Rate-limited. Always returns the same shape whether or not the
        new phone is available (anti-enumeration, spec §9).
      summary: Request a phone-change code (sent to the NEW phone)
      tags:
      - Auth
      security:
      - cookieAuth: []
      responses:
        '202':
          description: No response body
  /api/v1/auth/phone/change/verify:
    post:
      operationId: api_v1_auth_phone_change_verify_create
      summary: Verify phone-change code and switch phone
      tags:
      - Auth
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionUser'
          description: ''
  /api/v1/businesses:
    get:
      operationId: api_v1_businesses_list
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Business'
          description: ''
    post:
      operationId: api_v1_businesses_create
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Business'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Business'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Business'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Business'
          description: ''
  /api/v1/businesses/{business_id}/locations:
    get:
      operationId: api_v1_businesses_locations_list
      summary: List branches of own business
      parameters:
      - in: path
        name: business_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Locations
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Location'
          description: ''
    post:
      operationId: api_v1_businesses_locations_create
      summary: Add a branch
      parameters:
      - in: path
        name: business_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Locations
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Location'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Location'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Location'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Location'
          description: ''
  /api/v1/businesses/{id}:
    get:
      operationId: api_v1_businesses_retrieve
      summary: Own business profile
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Businesses
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Business'
          description: ''
    patch:
      operationId: api_v1_businesses_partial_update
      summary: Edit own business
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Businesses
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedBusiness'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedBusiness'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedBusiness'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Business'
          description: ''
  /api/v1/campaigns:
    get:
      operationId: api_v1_campaigns_list
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Campaign'
          description: ''
    post:
      operationId: api_v1_campaigns_create
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Campaign'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Campaign'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Campaign'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Campaign'
          description: ''
  /api/v1/campaigns/{id}:
    get:
      operationId: api_v1_campaigns_retrieve
      summary: Own campaign details
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Campaigns
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Campaign'
          description: ''
    patch:
      operationId: api_v1_campaigns_partial_update
      summary: Edit draft/rejected campaign
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Campaigns
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedCampaign'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedCampaign'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedCampaign'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Campaign'
          description: ''
  /api/v1/campaigns/{id}/placements:
    get:
      operationId: api_v1_campaigns_placements_list
      summary: Placements of an own campaign
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Campaigns
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Placement'
          description: ''
  /api/v1/campaigns/{id}/reviews:
    get:
      operationId: api_v1_campaigns_reviews_list
      description: Immutable review history (spec §5); newest first. Rejection reasons
        drive the correction/resubmission flow.
      summary: Moderation decisions for an own campaign
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Campaigns
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/CampaignReview'
          description: ''
  /api/v1/campaigns/{id}/submit:
    post:
      operationId: api_v1_campaigns_submit_create
      description: draft/rejected -> submitted. Payment happens separately via /orders/quote
        + /orders/{id}/checkout.
      summary: Submit campaign for moderation
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Campaigns
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/locations/{id}:
    get:
      operationId: api_v1_locations_retrieve
      summary: Own branch details
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Locations
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Location'
          description: ''
    patch:
      operationId: api_v1_locations_partial_update
      summary: Edit own branch
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Locations
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedLocation'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedLocation'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedLocation'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Location'
          description: ''
  /api/v1/media/upload:
    post:
      operationId: api_v1_media_upload_create
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/orders:
    get:
      operationId: api_v1_orders_list
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Order'
          description: ''
  /api/v1/orders/{id}:
    get:
      operationId: api_v1_orders_retrieve
      summary: Own order/payment status
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Orders
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OrderDetail'
          description: ''
  /api/v1/orders/{id}/checkout:
    post:
      operationId: api_v1_orders_checkout_create
      summary: Create idempotent provider checkout
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Orders
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/orders/{id}/refund-request:
    post:
      operationId: api_v1_orders_refund_request_create
      summary: Request a refund for a rejected/suspended paid order
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Orders
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/orders/quote:
    post:
      operationId: api_v1_orders_quote_create
      description: Server-side pricing with immutable snapshot (spec §6, §12). Response
        is the draft quote order; the frontend never sets prices.
      summary: Price quote for dates and branches
      tags:
      - Orders
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/payments/{provider}/webhook:
    post:
      operationId: api_v1_payments_webhook_create
      description: POST /api/v1/payments/{provider}/webhook — provider-initiated callbacks.
      parameters:
      - in: path
        name: provider
        schema:
          type: string
        required: true
      tags:
      - api
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/public/campaigns/{id}:
    get:
      operationId: api_v1_public_campaigns_retrieve
      description: Expired/unapproved/blocked campaigns return 404 (spec §14). Includes
        every currently eligible branch with address, hours and contacts so shared
        direct links work without client navigation state.
      summary: Active-only ad details with eligible branches
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Public
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PublicCampaignDetail'
          description: ''
  /api/v1/public/categories:
    get:
      operationId: api_v1_public_categories_list
      summary: Business categories
      tags:
      - Public
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Category'
          description: ''
  /api/v1/public/locations:
    get:
      operationId: api_v1_public_locations_list
      description: Returns id/coords/active-ads-count per location. Filter by category
        and free-text query; bounded limit.
      summary: 'Map pins: active locations in a bbox'
      tags:
      - Public
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/PublicLocation'
          description: ''
  /api/v1/public/locations/{id}:
    get:
      operationId: api_v1_public_locations_retrieve
      summary: Location detail with active ads
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Public
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PublicLocationDetail'
          description: ''
  /api/v1/public/reports:
    post:
      operationId: api_v1_public_reports_create
      summary: Report a suspicious business/ad
      tags:
      - Public
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/public/search:
    get:
      operationId: api_v1_public_search_retrieve
      description: Relevance first (name/business/ad headline match), then distance
        from the optional lat/lon.
      summary: Search locations and campaigns
      tags:
      - Public
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/renewals:
    get:
      operationId: api_v1_renewals_list
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/RenewalAgreement'
          description: ''
  /api/v1/renewals/{id}/cancel:
    post:
      operationId: api_v1_renewals_cancel_create
      summary: Disable future charge attempts (paid time remains)
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Renewals
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/renewals/enable:
    post:
      operationId: api_v1_renewals_enable_create
      summary: Re-enable explicit recurrence
      tags:
      - Renewals
      security:
      - cookieAuth: []
      responses:
        '200':
          description: No response body
  /health:
    get:
      operationId: health_probe
      description: Same probe on the no-slash path (strict probes); distinct operationId.
      tags:
      - health
      responses:
        '200':
          description: No response body
        '503':
          description: No response body
  /health/:
    get:
      operationId: health
      description: |-
        Liveness/readiness probe: checks DB connectivity.

        Returns HTTP 503 (not 200) when the database is unreachable, so
        `curl -f` deploy gates and uptime monitors register the outage.
      tags:
      - health
      responses:
        '200':
          description: No response body
        '503':
          description: No response body
