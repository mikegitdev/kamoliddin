          description: No response body
        '503':
          description: No response body
  /health/:
    get:
      operationId: health
      description: |-
        Liveness/readiness probe: checks DB connectivity.

        Returns HTTP 503 (not 200) when the database is unreachable, so
        `curl -f` deploy gates and uptime monitors register the outage.
      tags:
      - health
      responses:
        '200':
          description: No response body
        '503':
          description: No response body
components:
  schemas:
    AdLimitValue:
      type: object
      properties:
        key:
          type: string
          readOnly: true
        value:
          type: integer
          readOnly: true
      required:
      - key
      - value
    AdminActivity:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        action:
          type: string
          maxLength: 100
        entity:
          type: string
          maxLength: 60
        entity_id:
          type: string
          maxLength: 64
        actor_phone:
          type: string
          readOnly: true
        metadata: {}
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - action
      - actor_phone
      - created_at
      - entity
      - entity_id
      - id
    AdminBusiness:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 200
        slug:
          type: string
          maxLength: 220
          pattern: ^[-a-zA-Z0-9_]+$
        status:
          $ref: '#/components/schemas/EntityStatusEnum'
        category_ru:
          type: string
          readOnly: true
        category_uz:
          type: string
          readOnly: true
        owner_id:
          type: string
          format: uuid
          readOnly: true
        owner_phone:
          type: string
          readOnly: true
        owner_active:
          type: boolean
          readOnly: true
        locations_count:
          type: integer
          readOnly: true
        campaigns_count:
          type: integer
          readOnly: true
        live_ads:
          type: integer
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - campaigns_count
      - category_ru
      - category_uz
      - created_at
      - id
      - live_ads
      - locations_count
      - name
      - owner_active
      - owner_id
      - owner_phone
      - slug
    AdminCampaign:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        headline:
          type: string
          maxLength: 200
        review_status:
          $ref: '#/components/schemas/ReviewStatusEnum'
        review_version:
          type: integer
          maximum: 2147483647
          minimum: 0
        business_id:
          type: string
          format: uuid
          readOnly: true
        business_name:
          type: string
          readOnly: true
        owner_phone:
          type: string
          readOnly: true
        banner_url:
