openapi: 3.0.3
info:
  title: Local Advertising Map Platform API
  version: 1.0.0
  description: Public map/advertising API v1. Money is integer minor units (tiyin,
    UZS).
paths:
  /api/v1/admin/activity:
    get:
      operationId: api_v1_admin_activity_list
      description: GET /admin/activity — filterable, paginated immutable audit trail.
      parameters:
      - in: query
        name: action
        schema:
          type: string
        description: action substring, e.g. 'refund.'
      - in: query
        name: actor
        schema:
          type: string
        description: actor phone substring, or 'system'
      - in: query
        name: entity
        schema:
          type: string
        description: exact entity, e.g. campaign
      - in: query
        name: entity_id
        schema:
          type: string
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      - in: query
        name: q
        schema:
          type: string
        description: free text across action/entity id/metadata
      - in: query
        name: since
        schema:
          type: string
        description: ISO date/datetime
      - in: query
        name: until
        schema:
          type: string
        description: ISO date/datetime (inclusive day)
      tags:
      - api
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAdminActivityList'
          description: ''
  /api/v1/admin/activity/export:
    get:
      operationId: api_v1_admin_activity_export_retrieve
      summary: Audit trail as CSV (same filters, max 10000 rows)
      parameters:
      - in: query
        name: action
        schema:
          type: string
        description: action substring, e.g. 'refund.'
      - in: query
        name: actor
        schema:
          type: string
        description: actor phone substring, or 'system'
      - in: query
        name: entity
        schema:
          type: string
        description: exact entity, e.g. campaign
      - in: query
        name: entity_id
        schema:
          type: string
      - in: query
        name: q
        schema:
          type: string
        description: free text across action/entity id/metadata
      - in: query
        name: since
        schema:
          type: string
        description: ISO date/datetime
      - in: query
        name: until
        schema:
          type: string
        description: ISO date/datetime (inclusive day)
      tags:
      - Admin
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            text/csv:
              schema:
                type: string
          description: ''
  /api/v1/admin/businesses:
    get:
      operationId: api_v1_admin_businesses_list
      description: GET /admin/businesses?q=&status=&owner=
      parameters:
      - name: limit
