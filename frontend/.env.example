# Empty in dev: requests go through the Vite proxy (/api -> http://localhost:8000).
# For a deployed frontend served separately, set e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# --- Map provider (spec §10 [E]) — empty in dev (public OSM tiles + demo glyphs) ---
# Production MUST point these at a licensed provider (2GIS tiles or a paid/
# self-hosted OSM stack). Public OSM tiles must not serve production traffic.
# Example raster tile template: https://tiles.provider.uz/ad/{z}/{x}/{y}.png
VITE_MAP_TILES_URL=
# Glyph PBF template for the badge/count/name text layers (the MapLibre demo
# glyph host has no SLA and is dev-only). Self-hosted glyphs or the provider's:
# https://tiles.provider.uk/fonts/{fontstack}/{range}.pbf
VITE_MAP_GLYPHS_URL=
# Attribution shown in the map's attribution control for the tiles above.
VITE_MAP_ATTRIBUTION=
